digraph arquitectura {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=12, bgcolor="white",
         nodesep=0.28, ranksep=0.42, margin=0.15];
  node  [fontname="DejaVu Sans", fontsize=10, shape=box, style="filled,rounded",
         fillcolor="#EEF2F6", color="#46566B", penwidth=1.2, height=0.45,
         width=2.3, fixedsize=false, margin="0.12,0.07"];
  edge  [color="#46566B", penwidth=1.1, arrowsize=0.7];

  subgraph cluster_svc {
    label=<<b>Plano de servicios</b>>; fontsize=11; color="#8C5A2B"; penwidth=1.6;
    style=rounded; bgcolor="#FDF6EE"; labeljust=l;
    forgejo [label="Forgejo\nforja + registro", fillcolor="#F7E6D2"];
    argocd  [label="Argo CD\ndespliegue continuo", fillcolor="#F7E6D2"];
    web     [label="Web municipal", fillcolor="#F7E6D2"];
    vault   [label="Vaultwarden\ncontraseñas", fillcolor="#F7E6D2"];
    nextc   [label="Nextcloud\ndocumentos", fillcolor="#F7E6D2"];
    obs     [label="Prometheus · Grafana\nAlertmanager", fillcolor="#F7E6D2"];
    {rank=same; forgejo; argocd; web;}
    {rank=same; vault; nextc; obs;}
    forgejo -> vault [style=invis]; argocd -> nextc [style=invis]; web -> obs [style=invis];
  }

  subgraph cluster_k8s {
    label=<<b>Plano de orquestación — Kubernetes 1.36</b>>; fontsize=11; color="#2F6B5F";
    penwidth=1.6; style=rounded; bgcolor="#EFF7F4"; labeljust=l;
    cp     [label="Plano de control\napiserver · etcd · scheduler", fillcolor="#D9ECE5"];
    calico [label="Calico\nred de pods 10.244.0.0/16", fillcolor="#D9ECE5"];
    stor   [label="local-path\nvolúmenes persistentes", fillcolor="#D9ECE5"];
    metal  [label="MetalLB\nIP de la red local", fillcolor="#D9ECE5"];
    envoy  [label="Envoy Gateway\nGateway API", fillcolor="#D9ECE5"];
    certm  [label="cert-manager\nCA interna", fillcolor="#D9ECE5"];
    {rank=same; cp; calico; stor;}
    {rank=same; metal; envoy; certm;}
    cp -> metal [style=invis]; calico -> envoy [style=invis]; stor -> certm [style=invis];
  }

  subgraph cluster_sys {
    label=<<b>Plano de sistemas — Ubuntu Server 24.04 LTS</b>>; fontsize=11; color="#44507A";
    penwidth=1.6; style=rounded; bgcolor="#F0F2FA"; labeljust=l;
    km  [label="k8s-master\n192.168.18.54\n2 vCPU · 8 GiB", fillcolor="#DFE4F5"];
    kw  [label="k8s-worker\n192.168.18.53\n2 vCPU · 8 GiB", fillcolor="#DFE4F5"];
    d01 [label="docker-01\n192.168.18.52\n4 vCPU · 8 GiB", fillcolor="#DFE4F5"];
    pbs [label="pbs (LXC)\n192.168.18.55\nservidor de copias", fillcolor="#DFE4F5"];
    {rank=same; km; kw; d01; pbs;}
  }

  subgraph cluster_hyp {
    label=<<b>Plano de virtualización</b>>; fontsize=11; color="#6B3A6B"; penwidth=1.6;
    style=rounded; bgcolor="#F8F0F8"; labeljust=l;
    pve [label="Proxmox VE 9.2   ·   almacenamiento ZFS", fillcolor="#EDDCEE", width=6.0];
  }

  subgraph cluster_hw {
    label=<<b>Plano físico</b>>; fontsize=11; color="#555555"; penwidth=1.6; style=rounded;
    bgcolor="#F4F4F4"; labeljust=l;
    srv [label="Servidor   ·   AMD Ryzen 7 5800X   ·   32 GiB RAM", fillcolor="#E4E4E4", width=6.0];
    ssd [label="SSD 111,8 GB\nsistemas y bases de datos", fillcolor="#E4E4E4"];
    hdd [label="HDD 250 GB\ncopias y datos masivos", fillcolor="#E4E4E4"];
    {rank=same; ssd; hdd;}
    srv -> ssd [style=invis]; srv -> hdd [style=invis];
  }

  usr [label="Usuarios de la entidad", shape=box, style=filled, fillcolor="#FFFFFF",
       color="#46566B", width=2.0];

  usr   -> envoy [label=" HTTPS", fontsize=9];
  argocd -> cp [minlen=1]; web -> cp [style=invis]; obs -> cp [style=invis];
  metal  -> km   [minlen=1];
  kw     -> pve  [minlen=1];
  pve    -> srv  [minlen=1];
  pbs    -> hdd  [style=dashed, constraint=false, label=" copias", fontsize=9];
}
