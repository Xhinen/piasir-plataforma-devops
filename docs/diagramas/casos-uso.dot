digraph casos {
  rankdir=LR; bgcolor="white"; splines=true;
  node [fontname="Arial", fontsize=11];
  edge [fontname="Arial", fontsize=9, color="#555555", arrowsize=0.6];
  graph [fontname="Arial"];

  subgraph cluster_actores {
    label=""; color="white";
    admin  [label="Administrador\nde sistemas", shape=box, style="rounded,filled", fillcolor="#E8EDF5", color="#1F3864", height=0.8];
    dev    [label="Desarrollador",            shape=box, style="rounded,filled", fillcolor="#E8EDF5", color="#1F3864", height=0.8];
    emp    [label="Empleado",                 shape=box, style="rounded,filled", fillcolor="#E8EDF5", color="#1F3864", height=0.8];
  }

  subgraph cluster_sistema {
    label="Plataforma DevOps autoalojada";
    labeljust="l"; fontsize=12; fontname="Arial Bold";
    color="#1F3864"; style="rounded"; bgcolor="#FAFBFD";
    node [shape=ellipse, style=filled, fillcolor="white", color="#44546A"];
    uc1 [label="Dar de alta\nun servidor nuevo"];
    uc2 [label="Restaurar un servicio\ndesde copia"];
    uc3 [label="Actualizar el clúster"];
    uc4 [label="Publicar un cambio\nen el sitio web"];
    uc5 [label="Revertir un despliegue"];
    uc6 [label="Consultar una\ncontraseña compartida"];
    uc7 [label="Compartir un documento\nentre áreas"];
  }

  admin -> uc1; admin -> uc2; admin -> uc3;
  dev   -> uc4; dev   -> uc5;
  emp   -> uc6; emp   -> uc7;
}
