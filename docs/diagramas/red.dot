digraph red {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=12, bgcolor="white",
         nodesep=0.35, ranksep=0.45, margin=0.15];
  node  [fontname="DejaVu Sans", fontsize=10, shape=box, style="filled,rounded",
         fillcolor="#EEF2F6", color="#46566B", penwidth=1.2, margin="0.14,0.08"];
  edge  [color="#46566B", penwidth=1.2, arrowhead=none];

  inet   [label="Internet", shape=ellipse, style=filled, fillcolor="#FFFFFF"];
  router [label="Router / pasarela\n192.168.18.1", fillcolor="#E4E4E4"];
  pc     [label="Equipo de administración\nnavegador · SSH · kubectl", fillcolor="#FFFFFF"];
  lan    [label="Red local de la entidad   —   192.168.18.0/24",
          shape=box, style=filled, fillcolor="#44507A", fontcolor="white",
          color="#44507A", width=7.6, height=0.42];

  inet -> router;
  router -> lan;
  pc -> lan;

  subgraph cluster_srv {
    label=<<b>Servidor físico   —   Proxmox VE 9.2   —   192.168.18.50</b>>;
    fontsize=11; color="#6B3A6B"; penwidth=1.8; style=rounded; bgcolor="#FAF4FA"; labeljust=l;

    vmbr0 [label="vmbr0   ·   puente de red virtual", fillcolor="#EDDCEE", width=7.2, height=0.38];

    subgraph cluster_k8s {
      label=<<b>Clúster de Kubernetes</b>>; fontsize=10; color="#2F6B5F"; penwidth=1.5;
      style=rounded; bgcolor="#EFF7F4"; labeljust=l;
      km [label="k8s-master\n192.168.18.54\nplano de control", fillcolor="#D9ECE5"];
      kw [label="k8s-worker\n192.168.18.53\nnodo de trabajo", fillcolor="#D9ECE5"];
      pod [label="Red interna de pods\n10.244.0.0/16  (Calico)\nno enrutable desde la LAN",
           fillcolor="#FFFFFF", color="#2F6B5F", style="filled,rounded,dashed"];
      {rank=same; km; kw;}
      km -> pod [style=dotted, arrowhead=none];
      kw -> pod [style=dotted, arrowhead=none];
    }

    d01 [label="docker-01\n192.168.18.52\nconstrucción de imágenes\nmonitorización del anfitrión", fillcolor="#DFE4F5"];
    pbs [label="pbs  (contenedor LXC)\n192.168.18.55\nservidor de copias", fillcolor="#DFE4F5"];

    vmbr0 -> km; vmbr0 -> kw; vmbr0 -> d01; vmbr0 -> pbs;
  }

  lan -> vmbr0;

  vip [label="192.168.18.240\nIP virtual asignada por MetalLB\nentrada HTTP/HTTPS al clúster",
       fillcolor="#F7E6D2", color="#8C5A2B", penwidth=1.5];
  svc [label="Servicios publicados por nombre\nweb · forja · vault · nube  (*.lab.interno)",
       fillcolor="#FDF6EE", color="#8C5A2B"];

  lan -> vip [style=bold, color="#8C5A2B"];
  vip -> svc [style=bold, color="#8C5A2B", arrowhead=normal, arrowsize=0.7];
  {rank=same; pc; vip;}
}
