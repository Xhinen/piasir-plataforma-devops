# ---------------------------------------------------------------------------
# Secretos: nada de esto puede acabar nunca en el repositorio
# ---------------------------------------------------------------------------
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
!*.pub
kubeconfig
*.kubeconfig
.kube/
admin.conf
vault-pass*
.vault_pass*
*-secret.yaml
*-secrets.yaml
secrets.yml
secretos.yml
.env
.env.*

# Ansible
*.retry
.facts_cache/
ansible/collections/
ansible/roles/external/

# Kubernetes / Helm
charts/*.tgz

# Sistema operativo y editores
.DS_Store
Thumbs.db
*~
*.swp
.idea/
.vscode/

# Temporales de ofimática y salidas generadas
~$*
*.tmp
docs/memoria/*.pdf

# Artefactos empaquetados. Esta es la regla que habria evitado que
# fase10-roles.tar.gz acabara dentro del inventario.
*.tar.gz
*.tgz
*.zip
 
# Peticiones de firma de certificado: material intermedio de la fase 11.
# El certificado publico de la CA (.crt) SI se versiona: es lo que hay que
# repartir a los equipos. La clave privada ya la cubre la regla *.key.
*.csr
 
# Cache local de Ansible y respaldos de editor
.ansible/
*.bak
*.swo
 
# Registros crudos de sesion generados con script(1). Pueden contener
# testigos de union al cluster, contrasenas tecleadas por error o volcados
# de ficheros que no deben salir. Lo que vale de ahi se traslada depurado
# a docs/cuaderno/.
sesion-*.log
cuaderno-crudo/

# Ignorar archivo de clave maestra
clave-maestra-*.yaml
